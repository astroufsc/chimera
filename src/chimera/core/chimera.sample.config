
chimera:
  host: 127.0.0.1
  port: 7666

site:
  name: CTIO
  latitude: "-30:10:04.31"
  longitude: "-70:48:20.48"
  altitude: 2187
  flat_alt: 80
  flat_az : 10

telescope:
  name: fake
  type: FakeTelescope
  
rotator:
  name: fake
  type: FakeRotator

camera:
  name: fake
  type: FakeCamera
  use_dss: True

filterwheel:
  type: FakeFilterWheel
  name: fake
  filters: [U, B, V, R, I]

focuser:
  name: fake
  type: FakeFocuser
    
dome:
  name: fake
  type: FakeDome
  mode: track
  telescope: /FakeTelescope/fake

lamp:
  name: fake
  type: FakeLamp

fan:
  name: fake
  type: FakeFan

controller:

  - type: Scheduler
    name: sched

  - type: Autofocus
    name: fake
    camera: /FakeCamera/fake
    filterwheel: /FakeFilterWheel/fake

  - type: ImageServer
    name: fake
    httpd: True
    autoload: False

  # CHZ1 pixel stream: pushes every readout of /Camera/0 to browser viewers
  - type: Chz1Streamer
    name: fake
    ws_port: 7668

  # Monitoring cameras -- dome, all-sky, weather. Nothing to do with the science
  # path: these are ordinary RTSP/ONVIF/UVC cameras whose H.264 is passed
  # straight through to a <video> tag. Needs the go2rtc binary on PATH
  # (https://github.com/AlexxIT/go2rtc/releases); commented out so a default
  # install starts without it. Names matter: "allsky" and "dome" are what the
  # web app looks for.
  #
  # An IP camera is passthrough -- no "#video=" suffix, so the camera's own
  # H.264 reaches the browser untouched. A UVC webcam has to be transcoded, and
  # on macOS it must also carry video_size and framerate: without them ffmpeg
  # asks avfoundation for 29.97 fps, which it does not offer, and the source
  # silently produces nothing.
  #
  # - type: VideoStreamer
  #   name: site
  #   public_host: default
  #   cameras:
  #     dome: "rtsp://USER:PASS@CAMERA-HOST:554/Streaming/channels/101"
  #     allsky: "ffmpeg:device?video=0&video_size=1280x720&framerate=30#video=h264"

weatherstation:
  - type: FakeWeatherStation
    name: fake
